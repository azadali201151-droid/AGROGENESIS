{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Scan": {
      "title": "Crop Scan",
      "description": "History of crop analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "image": { "type": "string", "description": "Base64 or URL thumbnail" },
        "result": { "type": "object" },
        "language": { "type": "string" }
      },
      "required": ["id", "userId", "timestamp", "image", "result"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profiles"
    },
    "/users/{userId}/scans/{scanId}": {
      "schema": "Scan",
      "description": "User specific crop analysis history"
    }
  }
}
